rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId}/progress/{subject} {
      function own() { return request.auth != null && request.auth.uid == studentId; }
      allow read, delete: if own() && subject in ['math', 'physics'];
      allow create, update: if own() && subject in ['math', 'physics']
        && request.resource.data.keys().hasOnly(['schema', 'payload', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 400000
        && request.resource.data.updatedAt == request.time;
    }
  }
}
